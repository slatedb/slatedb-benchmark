{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmark.slatedb.io/schema/run.json",
  "title": "SlateDB benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "run_id",
    "golden_id",
    "started_at",
    "finished_at",
    "patches",
    "source",
    "golden_runner_commit",
    "resolved_configuration",
    "max_parallel",
    "results"
  ],
  "properties": {
    "status": { "const": "ok" },
    "run_id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,128}$"
    },
    "golden_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/patch" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slate_version",
        "slate_commit",
        "runner_version",
        "runner_commit",
        "lockfile_sha256"
      ],
      "properties": {
        "slate_version": { "type": "string", "minLength": 1 },
        "slate_commit": { "type": "string", "minLength": 1 },
        "runner_version": { "type": "string", "minLength": 1 },
        "runner_commit": { "type": "string", "minLength": 1 },
        "lockfile_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "golden_runner_commit": { "type": "string", "minLength": 1 },
    "resolved_configuration": {
      "type": "object",
      "required": ["golden"],
      "minProperties": 2,
      "maxProperties": 11,
      "propertyNames": {
        "enum": [
          "golden",
          "idle",
          "point-read-uniform",
          "point-read-skewed",
          "point-read-missing",
          "read-heavy",
          "balanced",
          "update-heavy",
          "range-scan",
          "sustained-ingest",
          "transaction-contention"
        ]
      },
      "additionalProperties": { "type": "object" }
    },
    "max_parallel": { "type": "integer", "minimum": 1 },
    "transfer_capacity": { "$ref": "#/$defs/warpTransferCapacity" },
    "results": {
      "type": "object",
      "required": ["golden.json"],
      "minProperties": 3,
      "maxProperties": 21,
      "propertyNames": {
        "pattern": "^(golden|workload/(idle|point-read-uniform|point-read-skewed|point-read-missing|read-heavy|balanced|update-heavy|range-scan|sustained-ingest|transaction-contention)/(result|series))\\.json$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "$defs": {
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^/]+\\.patch$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "warpTransferCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "timestamp",
        "scale",
        "runner_type",
        "object_store",
        "endpoint",
        "region",
        "tool",
        "benchmarks"
      ],
      "properties": {
        "version": { "const": 3 },
        "status": { "const": "ok" },
        "timestamp": { "type": "string", "format": "date-time" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "runner_type": { "type": "string", "minLength": 1 },
        "object_store": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "warp" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "benchmarks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/warpBenchmark" }
        }
      }
    },
    "warpBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "operation",
        "object_size_bytes",
        "concurrency",
        "duration_seconds",
        "latency_ms",
        "benchdata"
      ],
      "properties": {
        "name": {
          "enum": ["large-put", "large-get", "small-put", "small-get", "small-list"]
        },
        "operation": { "enum": ["PUT", "GET", "LIST"] },
        "object_size_bytes": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "latency_ms": { "$ref": "#/$defs/warpLatency" },
        "benchdata": {
          "type": "string",
          "pattern": "^warp/(large-(put|get)|small-(put|get|list))\\.csv\\.zst$"
        }
      }
    },
    "warpLatency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "$ref": "#/$defs/warpLatencySummary" },
        "ttfb": { "$ref": "#/$defs/warpLatencySummary" }
      }
    },
    "warpLatencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "p50", "p90", "p99", "min", "max"],
      "properties": {
        "average": { "type": "number", "minimum": 0 },
        "p50": { "type": "number", "minimum": 0 },
        "p90": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      }
    }
  }
}
