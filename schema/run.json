{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "golden_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppliedPatch"
      }
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "golden_runner_commit": {
      "type": "string"
    },
    "resolved_configuration": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResultConfiguration"
      }
    },
    "max_parallel": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "run_id",
    "golden_id",
    "started_at",
    "finished_at",
    "patches",
    "source",
    "golden_runner_commit",
    "resolved_configuration",
    "max_parallel",
    "results"
  ],
  "$defs": {
    "AppliedPatch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "slate_version": {
          "type": "string"
        },
        "slate_commit": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        },
        "runner_commit": {
          "type": "string"
        },
        "lockfile_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slate_version",
        "slate_commit",
        "runner_version",
        "runner_commit",
        "lockfile_sha256"
      ]
    },
    "ResultConfiguration": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "format": "double"
        },
        "dataset": {
          "$ref": "#/$defs/DatasetConfig"
        },
        "caches": {
          "$ref": "#/$defs/CacheConfig"
        },
        "task": {
          "$ref": "#/$defs/TaskConfig"
        },
        "slate_settings": true,
        "slate_default_settings": true,
        "build_profile": {
          "type": "string"
        },
        "enabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "dataset",
        "caches",
        "task",
        "slate_settings",
        "build_profile",
        "enabled_features"
      ]
    },
    "DatasetConfig": {
      "type": "object",
      "properties": {
        "record_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "key_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_compression_ratio": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_count",
        "key_bytes",
        "value_bytes",
        "value_compression_ratio"
      ]
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "block_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "block_bytes",
        "metadata_bytes"
      ]
    },
    "TaskConfig": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "clients": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "warmup_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "measurement_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "initial_state": {
          "type": "string"
        },
        "key_selection": {
          "type": "string"
        },
        "operation_mix": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "scan_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_hot_keys": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "transaction_reads": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_updates": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "clients",
        "warmup_ms",
        "measurement_ms",
        "initial_state",
        "key_selection",
        "operation_mix"
      ]
    },
    "Task": {
      "type": "string",
      "enum": [
        "bulk-load",
        "compaction",
        "idle",
        "point-read-uniform",
        "point-read-skewed",
        "point-read-missing",
        "read-heavy",
        "balanced",
        "update-heavy",
        "range-scan",
        "sustained-ingest",
        "transaction-contention"
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/run.json"
}
