{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunManifest",
  "description": "Manifest for one versioned collection of workload artifacts.",
  "type": "object",
  "properties": {
    "status": {
      "description": "Completion status; valid manifests use `ok`.",
      "type": "string"
    },
    "run_id": {
      "description": "Run identifier, normally derived from the GitHub Actions run.",
      "type": "string"
    },
    "golden_id": {
      "description": "Golden dataset identifier shared by the workloads.",
      "type": "string"
    },
    "started_at": {
      "description": "RFC 3339 timestamp captured when execution began.",
      "type": "string"
    },
    "finished_at": {
      "description": "RFC 3339 timestamp captured when bundling completed.",
      "type": "string"
    },
    "patches": {
      "description": "Ordered SlateDB patches applied to the runner.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AppliedPatch"
      }
    },
    "source": {
      "description": "Source identity shared by every workload.",
      "$ref": "#/$defs/SourceIdentity"
    },
    "golden_runner_commit": {
      "description": "Runner commit used to build the golden checkpoint.",
      "type": "string"
    },
    "resolved_configuration": {
      "description": "Task name to effective published configuration.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResultConfiguration"
      }
    },
    "max_parallel": {
      "description": "Maximum workload parallelism represented by the bundle.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "results": {
      "description": "Relative artifact path to lowercase SHA-256 digest.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "run_id",
    "golden_id",
    "started_at",
    "finished_at",
    "patches",
    "source",
    "golden_runner_commit",
    "resolved_configuration",
    "max_parallel",
    "results"
  ],
  "$defs": {
    "AppliedPatch": {
      "description": "SlateDB patch applied before compiling a benchmark runner.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Patch filename, which also determines application order.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase SHA-256 digest of the patch contents.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "SourceIdentity": {
      "description": "Source revisions that make a benchmark artifact reproducible.",
      "type": "object",
      "properties": {
        "slate_version": {
          "description": "SlateDB version label used to group published results.",
          "type": "string"
        },
        "slate_commit": {
          "description": "Exact SlateDB Git commit compiled into the runner.",
          "type": "string"
        },
        "runner_version": {
          "description": "Version of the benchmark runner crate.",
          "type": "string"
        },
        "runner_commit": {
          "description": "Exact benchmark-runner Git commit.",
          "type": "string"
        },
        "lockfile_sha256": {
          "description": "SHA-256 digest of the runner's `Cargo.lock`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slate_version",
        "slate_commit",
        "runner_version",
        "runner_commit",
        "lockfile_sha256"
      ]
    },
    "ResultConfiguration": {
      "description": "Published configuration for one preparation phase or workload.",
      "type": "object",
      "properties": {
        "scale": {
          "description": "Decimal scale factor applied to catalog defaults.",
          "type": "number",
          "format": "double"
        },
        "dataset": {
          "description": "Dataset shape used by the task.",
          "$ref": "#/$defs/DatasetConfig"
        },
        "caches": {
          "description": "Benchmark-managed cache capacities.",
          "$ref": "#/$defs/CacheConfig"
        },
        "task": {
          "description": "Workload behavior and duration.",
          "$ref": "#/$defs/TaskConfig"
        },
        "slate_settings": {
          "description": "Effective SlateDB settings serialized as JSON."
        },
        "slate_default_settings": {
          "description": "SlateDB defaults used to identify explicit overrides."
        },
        "build_profile": {
          "description": "Rust build profile used for the runner.",
          "type": "string"
        },
        "enabled_features": {
          "description": "SlateDB Cargo features enabled in the runner.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "dataset",
        "caches",
        "task",
        "slate_settings",
        "build_profile",
        "enabled_features"
      ]
    },
    "DatasetConfig": {
      "description": "Shape and logical size of records used by a benchmark task.",
      "type": "object",
      "properties": {
        "record_count": {
          "description": "Number of records in the key-selection domain.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "key_bytes": {
          "description": "Encoded key size in bytes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_bytes": {
          "description": "Generated value size in bytes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_compression_ratio": {
          "description": "Target ratio of uncompressed to compressed value bytes.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_count",
        "key_bytes",
        "value_bytes",
        "value_compression_ratio"
      ]
    },
    "CacheConfig": {
      "description": "In-memory cache capacities used by the benchmark runner.",
      "type": "object",
      "properties": {
        "block_bytes": {
          "description": "Block-cache capacity in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata_bytes": {
          "description": "Metadata-cache capacity in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "block_bytes",
        "metadata_bytes"
      ]
    },
    "TaskConfig": {
      "description": "Runtime shape of one preparation phase or workload.",
      "type": "object",
      "properties": {
        "task": {
          "description": "Catalog task represented by this configuration.",
          "$ref": "#/$defs/Task"
        },
        "clients": {
          "description": "Number of concurrent closed-loop clients.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "warmup_ms": {
          "description": "Warmup duration in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "measurement_ms": {
          "description": "Measured client duration in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "initial_state": {
          "description": "Initial database state: `empty`, `golden`, or `none`.",
          "type": "string"
        },
        "key_selection": {
          "description": "Key-selection strategy used by workload operations.",
          "type": "string"
        },
        "operation_mix": {
          "description": "Operation name to probability map; active workloads sum to one.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "scan_limit": {
          "description": "Maximum number of records returned by each scan.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_hot_keys": {
          "description": "Number of keys in the transaction contention hot set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "transaction_reads": {
          "description": "Reads performed by each transaction attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_updates": {
          "description": "Updates performed by each transaction attempt.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "clients",
        "warmup_ms",
        "measurement_ms",
        "initial_state",
        "key_selection",
        "operation_mix"
      ]
    },
    "Task": {
      "description": "A preparation phase or workload from the benchmark catalog.",
      "oneOf": [
        {
          "description": "The `bulk-load` benchmark task.",
          "type": "string",
          "const": "bulk-load"
        },
        {
          "description": "The `compaction` benchmark task.",
          "type": "string",
          "const": "compaction"
        },
        {
          "description": "The `idle` benchmark task.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "The `point-read-uniform` benchmark task.",
          "type": "string",
          "const": "point-read-uniform"
        },
        {
          "description": "The `point-read-skewed` benchmark task.",
          "type": "string",
          "const": "point-read-skewed"
        },
        {
          "description": "The `point-read-missing` benchmark task.",
          "type": "string",
          "const": "point-read-missing"
        },
        {
          "description": "The `read-heavy` benchmark task.",
          "type": "string",
          "const": "read-heavy"
        },
        {
          "description": "The `balanced` benchmark task.",
          "type": "string",
          "const": "balanced"
        },
        {
          "description": "The `update-heavy` benchmark task.",
          "type": "string",
          "const": "update-heavy"
        },
        {
          "description": "The `range-scan` benchmark task.",
          "type": "string",
          "const": "range-scan"
        },
        {
          "description": "The `sustained-ingest` benchmark task.",
          "type": "string",
          "const": "sustained-ingest"
        },
        {
          "description": "The `transaction-contention` benchmark task.",
          "type": "string",
          "const": "transaction-contention"
        }
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/run.json"
}
