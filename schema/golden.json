{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldenManifest",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "golden_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "configuration": {
      "$ref": "#/$defs/ResultConfiguration"
    },
    "checkpoint": {
      "$ref": "#/$defs/CheckpointReference"
    },
    "dataset": {
      "$ref": "#/$defs/GoldenDatasetMetadata"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "golden_id",
    "timestamp",
    "source",
    "environment",
    "configuration",
    "checkpoint",
    "dataset"
  ],
  "$defs": {
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "slate_version": {
          "type": "string"
        },
        "slate_commit": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        },
        "runner_commit": {
          "type": "string"
        },
        "lockfile_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slate_version",
        "slate_commit",
        "runner_version",
        "runner_commit",
        "lockfile_sha256"
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "runner_type": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "cpu_cores": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "ram_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "local_disk": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "object_store": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "runner_type",
        "hostname",
        "cpu_model",
        "cpu_cores",
        "ram_bytes",
        "local_disk",
        "os",
        "kernel",
        "object_store",
        "endpoint",
        "region"
      ]
    },
    "ResultConfiguration": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "format": "double"
        },
        "dataset": {
          "$ref": "#/$defs/DatasetConfig"
        },
        "caches": {
          "$ref": "#/$defs/CacheConfig"
        },
        "task": {
          "$ref": "#/$defs/TaskConfig"
        },
        "slate_settings": true,
        "slate_default_settings": true,
        "build_profile": {
          "type": "string"
        },
        "enabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "dataset",
        "caches",
        "task",
        "slate_settings",
        "build_profile",
        "enabled_features"
      ]
    },
    "DatasetConfig": {
      "type": "object",
      "properties": {
        "record_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "key_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_compression_ratio": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_count",
        "key_bytes",
        "value_bytes",
        "value_compression_ratio"
      ]
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "block_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "block_bytes",
        "metadata_bytes"
      ]
    },
    "TaskConfig": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "clients": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "warmup_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "measurement_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "initial_state": {
          "type": "string"
        },
        "key_selection": {
          "type": "string"
        },
        "operation_mix": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "scan_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_hot_keys": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "transaction_reads": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_updates": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "clients",
        "warmup_ms",
        "measurement_ms",
        "initial_state",
        "key_selection",
        "operation_mix"
      ]
    },
    "Task": {
      "type": "string",
      "enum": [
        "bulk-load",
        "compaction",
        "idle",
        "point-read-uniform",
        "point-read-skewed",
        "point-read-missing",
        "read-heavy",
        "balanced",
        "update-heavy",
        "range-scan",
        "sustained-ingest",
        "transaction-contention"
      ]
    },
    "CheckpointReference": {
      "type": "object",
      "properties": {
        "database_path": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": "string"
        },
        "manifest_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lsm_digest_sha256": {
          "type": "string"
        },
        "live_sst_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "database_path",
        "checkpoint_id",
        "manifest_id",
        "lsm_digest_sha256",
        "live_sst_bytes"
      ]
    },
    "GoldenDatasetMetadata": {
      "type": "object",
      "properties": {
        "record_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "key_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "logical_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "live_sst_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "record_count",
        "key_bytes",
        "value_bytes",
        "logical_bytes",
        "live_sst_bytes"
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/golden.json"
}
