{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkloadSeries",
  "type": "object",
  "properties": {
    "rate_elapsed_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "rate_duration_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "latency_elapsed_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "latency_duration_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "resource_elapsed_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "resource_duration_ns": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "application": {
      "$ref": "#/$defs/ApplicationSeries"
    },
    "object_store": {
      "$ref": "#/$defs/ObjectStoreSeries"
    },
    "process": {
      "$ref": "#/$defs/ProcessSeries"
    },
    "machine": {
      "$ref": "#/$defs/MachineSeries"
    }
  },
  "additionalProperties": false,
  "required": [
    "rate_elapsed_ns",
    "rate_duration_ns",
    "latency_elapsed_ns",
    "latency_duration_ns",
    "resource_elapsed_ns",
    "resource_duration_ns",
    "application",
    "object_store",
    "process",
    "machine"
  ],
  "$defs": {
    "ApplicationSeries": {
      "type": "object",
      "properties": {
        "operations_per_second": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "bytes_per_second": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "latency_ns": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LatencyTimeSeries"
          }
        },
        "latency_histograms": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/HistogramSeries"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operations_per_second",
        "bytes_per_second",
        "latency_ns",
        "latency_histograms"
      ]
    },
    "LatencyTimeSeries": {
      "type": "object",
      "properties": {
        "avg": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p001": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p01": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p50": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p99": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p999": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "avg",
        "p001",
        "p01",
        "p50",
        "p99",
        "p999"
      ]
    },
    "HistogramSeries": {
      "type": "object",
      "properties": {
        "upper_bound_ns": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "upper_bound_ns",
        "counts"
      ]
    },
    "ObjectStoreSeries": {
      "type": "object",
      "properties": {
        "requests_per_second": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "bytes_per_second": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "requests_per_second",
        "bytes_per_second"
      ]
    },
    "ProcessSeries": {
      "type": "object",
      "properties": {
        "cpu_cores": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "rss_bytes": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "rss_bytes"
      ]
    },
    "MachineSeries": {
      "type": "object",
      "properties": {
        "cpu_percent": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "rss_bytes": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "network_receive_bytes_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "network_send_bytes_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_read_bytes_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_write_bytes_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_read_operations_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_write_operations_per_second": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_percent",
        "rss_bytes",
        "network_receive_bytes_per_second",
        "network_send_bytes_per_second",
        "disk_read_bytes_per_second",
        "disk_write_bytes_per_second",
        "disk_read_operations_per_second",
        "disk_write_operations_per_second"
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/series.json"
}
