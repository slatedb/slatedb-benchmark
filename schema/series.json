{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkloadSeries",
  "description": "Time-series sidecar associated with one workload result.",
  "type": "object",
  "properties": {
    "rate_elapsed_ns": {
      "description": "End of each operation and object-store rate window, relative to sampling start.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "rate_duration_ns": {
      "description": "Duration represented by each rate window.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "latency_elapsed_ns": {
      "description": "End of each application-latency window, relative to sampling start.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "latency_duration_ns": {
      "description": "Duration represented by each latency window.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "resource_elapsed_ns": {
      "description": "End of each process and machine window, relative to sampling start.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "resource_duration_ns": {
      "description": "Duration represented by each resource window.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      }
    },
    "application": {
      "description": "Application time-series values.",
      "$ref": "#/$defs/ApplicationSeries"
    },
    "object_store": {
      "description": "Object-store time-series values.",
      "$ref": "#/$defs/ObjectStoreSeries"
    },
    "process": {
      "description": "Process time-series values.",
      "$ref": "#/$defs/ProcessSeries"
    },
    "machine": {
      "description": "Host time-series values.",
      "$ref": "#/$defs/MachineSeries"
    }
  },
  "additionalProperties": false,
  "required": [
    "rate_elapsed_ns",
    "rate_duration_ns",
    "latency_elapsed_ns",
    "latency_duration_ns",
    "resource_elapsed_ns",
    "resource_duration_ns",
    "application",
    "object_store",
    "process",
    "machine"
  ],
  "$defs": {
    "ApplicationSeries": {
      "description": "Application metrics sampled over time.",
      "type": "object",
      "properties": {
        "operations_per_second": {
          "description": "Operation name to calls per rate window.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "bytes_per_second": {
          "description": "Operation name to logical bytes per rate window.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "latency_ns": {
          "description": "Operation name to latency values per latency window.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LatencyTimeSeries"
          }
        },
        "latency_histograms": {
          "description": "Operation name to full-interval sparse latency histogram.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/HistogramSeries"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operations_per_second",
        "bytes_per_second",
        "latency_ns",
        "latency_histograms"
      ]
    },
    "LatencyTimeSeries": {
      "description": "Per-window latency summaries for one application operation.\n\nA missing value means the operation had no observations in that window.",
      "type": "object",
      "properties": {
        "avg": {
          "description": "Mean latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p001": {
          "description": "0.1st-percentile latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p01": {
          "description": "1st-percentile latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p50": {
          "description": "Median latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p99": {
          "description": "99th-percentile latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "p999": {
          "description": "99.9th-percentile latency per window in nanoseconds.",
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "avg",
        "p001",
        "p01",
        "p50",
        "p99",
        "p999"
      ]
    },
    "HistogramSeries": {
      "description": "Sparse HDR-histogram buckets for one latency metric.",
      "type": "object",
      "properties": {
        "upper_bound_ns": {
          "description": "Inclusive bucket upper bounds in nanoseconds.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "counts": {
          "description": "Observation counts corresponding to `upper_bound_ns`.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "upper_bound_ns",
        "counts"
      ]
    },
    "ObjectStoreSeries": {
      "description": "Object-store metrics sampled over time.",
      "type": "object",
      "properties": {
        "requests_per_second": {
          "description": "HTTP method to requests per rate window.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "bytes_per_second": {
          "description": "HTTP method to body bytes per rate window.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "requests_per_second",
        "bytes_per_second"
      ]
    },
    "ProcessSeries": {
      "description": "Process resource samples over time.",
      "type": "object",
      "properties": {
        "cpu_cores": {
          "description": "CPU cores consumed in each resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "rss_bytes": {
          "description": "Resident set size in bytes in each resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "rss_bytes"
      ]
    },
    "MachineSeries": {
      "description": "Host resource and I/O samples over time.",
      "type": "object",
      "properties": {
        "cpu_percent": {
          "description": "Host CPU utilization percentage per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "memory_used_bytes": {
          "description": "Host memory in use, in bytes, per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "network_receive_bytes_per_second": {
          "description": "Network receive rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "network_send_bytes_per_second": {
          "description": "Network send rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_read_bytes_per_second": {
          "description": "Physical disk read-byte rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_write_bytes_per_second": {
          "description": "Physical disk write-byte rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_read_operations_per_second": {
          "description": "Physical disk read-operation rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "disk_write_operations_per_second": {
          "description": "Physical disk write-operation rate per resource window.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_percent",
        "memory_used_bytes",
        "network_receive_bytes_per_second",
        "network_send_bytes_per_second",
        "disk_read_bytes_per_second",
        "disk_write_bytes_per_second",
        "disk_read_operations_per_second",
        "disk_write_operations_per_second"
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/series.json"
}
