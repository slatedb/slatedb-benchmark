{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkloadResult",
  "type": "object",
  "properties": {
    "status": {
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/Task"
    },
    "golden_id": {
      "type": "string"
    },
    "session": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "actions_log_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "configuration": {
      "$ref": "#/$defs/ResultConfiguration"
    },
    "initial_state": {
      "$ref": "#/$defs/InitialState"
    },
    "client_measurement_ns": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "durability_drain_ns": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "recorded_interval_ns": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "application": {
      "$ref": "#/$defs/ApplicationMetrics"
    },
    "object_store": {
      "$ref": "#/$defs/ObjectStoreMetrics"
    },
    "process": {
      "$ref": "#/$defs/ProcessStatistics"
    },
    "machine": {
      "$ref": "#/$defs/MachineStatistics"
    },
    "series": {
      "$ref": "#/$defs/SeriesReference"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "task",
    "golden_id",
    "session",
    "timestamp",
    "source",
    "environment",
    "configuration",
    "initial_state",
    "client_measurement_ns",
    "durability_drain_ns",
    "recorded_interval_ns",
    "application",
    "object_store",
    "process",
    "machine",
    "series"
  ],
  "$defs": {
    "Task": {
      "type": "string",
      "enum": [
        "bulk-load",
        "compaction",
        "idle",
        "point-read-uniform",
        "point-read-skewed",
        "point-read-missing",
        "read-heavy",
        "balanced",
        "update-heavy",
        "range-scan",
        "sustained-ingest",
        "transaction-contention"
      ]
    },
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "slate_version": {
          "type": "string"
        },
        "slate_commit": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        },
        "runner_commit": {
          "type": "string"
        },
        "lockfile_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slate_version",
        "slate_commit",
        "runner_version",
        "runner_commit",
        "lockfile_sha256"
      ]
    },
    "Environment": {
      "type": "object",
      "properties": {
        "runner_type": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "cpu_model": {
          "type": "string"
        },
        "cpu_cores": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "ram_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "local_disk": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "object_store": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "runner_type",
        "hostname",
        "cpu_model",
        "cpu_cores",
        "ram_bytes",
        "local_disk",
        "os",
        "kernel",
        "object_store",
        "endpoint",
        "region"
      ]
    },
    "ResultConfiguration": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "format": "double"
        },
        "dataset": {
          "$ref": "#/$defs/DatasetConfig"
        },
        "caches": {
          "$ref": "#/$defs/CacheConfig"
        },
        "task": {
          "$ref": "#/$defs/TaskConfig"
        },
        "slate_settings": true,
        "slate_default_settings": true,
        "build_profile": {
          "type": "string"
        },
        "enabled_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "dataset",
        "caches",
        "task",
        "slate_settings",
        "build_profile",
        "enabled_features"
      ]
    },
    "DatasetConfig": {
      "type": "object",
      "properties": {
        "record_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "key_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "value_compression_ratio": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_count",
        "key_bytes",
        "value_bytes",
        "value_compression_ratio"
      ]
    },
    "CacheConfig": {
      "type": "object",
      "properties": {
        "block_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "metadata_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "block_bytes",
        "metadata_bytes"
      ]
    },
    "TaskConfig": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/Task"
        },
        "clients": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "warmup_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "measurement_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "initial_state": {
          "type": "string"
        },
        "key_selection": {
          "type": "string"
        },
        "operation_mix": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "scan_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_hot_keys": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "transaction_reads": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "transaction_updates": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "clients",
        "warmup_ms",
        "measurement_ms",
        "initial_state",
        "key_selection",
        "operation_mix"
      ]
    },
    "InitialState": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "lsm_digest_sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "lsm_digest_sha256"
      ]
    },
    "ApplicationMetrics": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RateSummary"
          }
        },
        "throughput": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ThroughputSummary"
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LatencySummary"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operations",
        "throughput",
        "latency"
      ]
    },
    "RateSummary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "avg_per_second": {
          "type": "number",
          "format": "double"
        },
        "p001_per_second": {
          "type": "number",
          "format": "double"
        },
        "p01_per_second": {
          "type": "number",
          "format": "double"
        },
        "p50_per_second": {
          "type": "number",
          "format": "double"
        },
        "p99_per_second": {
          "type": "number",
          "format": "double"
        },
        "p999_per_second": {
          "type": "number",
          "format": "double"
        },
        "min_per_second": {
          "type": "number",
          "format": "double"
        },
        "max_per_second": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "total",
        "avg_per_second",
        "p001_per_second",
        "p01_per_second",
        "p50_per_second",
        "p99_per_second",
        "p999_per_second",
        "min_per_second",
        "max_per_second"
      ]
    },
    "ThroughputSummary": {
      "type": "object",
      "properties": {
        "total_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "avg_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "p001_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "p01_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "p50_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "p99_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "p999_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "min_bytes_per_second": {
          "type": "number",
          "format": "double"
        },
        "max_bytes_per_second": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "total_bytes",
        "avg_bytes_per_second",
        "p001_bytes_per_second",
        "p01_bytes_per_second",
        "p50_bytes_per_second",
        "p99_bytes_per_second",
        "p999_bytes_per_second",
        "min_bytes_per_second",
        "max_bytes_per_second"
      ]
    },
    "LatencySummary": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "avg_ns": {
          "type": "number",
          "format": "double"
        },
        "p001_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p01_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p50_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p99_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p999_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "min_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "count",
        "avg_ns",
        "p001_ns",
        "p01_ns",
        "p50_ns",
        "p99_ns",
        "p999_ns",
        "min_ns",
        "max_ns"
      ]
    },
    "ObjectStoreMetrics": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RateSummary"
          }
        },
        "throughput": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ThroughputSummary"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "requests",
        "throughput"
      ]
    },
    "ProcessStatistics": {
      "type": "object",
      "properties": {
        "cpu_cores": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "rss_bytes": {
          "$ref": "#/$defs/DistributionSummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "rss_bytes"
      ]
    },
    "DistributionSummary": {
      "type": "object",
      "properties": {
        "avg": {
          "type": "number",
          "format": "double"
        },
        "p001": {
          "type": "number",
          "format": "double"
        },
        "p01": {
          "type": "number",
          "format": "double"
        },
        "p50": {
          "type": "number",
          "format": "double"
        },
        "p99": {
          "type": "number",
          "format": "double"
        },
        "p999": {
          "type": "number",
          "format": "double"
        },
        "min": {
          "type": "number",
          "format": "double"
        },
        "max": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "avg",
        "p001",
        "p01",
        "p50",
        "p99",
        "p999",
        "min",
        "max"
      ]
    },
    "MachineStatistics": {
      "type": "object",
      "properties": {
        "cpu_percent": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "rss_bytes": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "network_receive_bytes_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "network_send_bytes_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "disk_read_bytes_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "disk_write_bytes_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "disk_read_operations_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        },
        "disk_write_operations_per_second": {
          "$ref": "#/$defs/DistributionSummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_percent",
        "rss_bytes",
        "network_receive_bytes_per_second",
        "network_send_bytes_per_second",
        "disk_read_bytes_per_second",
        "disk_write_bytes_per_second",
        "disk_read_operations_per_second",
        "disk_write_operations_per_second"
      ]
    },
    "SeriesReference": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ]
    }
  },
  "$id": "https://benchmark.slatedb.io/schema/result.json"
}
