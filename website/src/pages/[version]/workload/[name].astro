---
import WorkloadResultPage from '../../../components/WorkloadResultPage.astro';
import { loadDatasetResults, latestRoutes } from '../../../lib/results';
import { loadWorkloadPageData } from '../../../lib/workload-pages';

export async function getStaticPaths() {
  const { workloads, descriptions } = await loadWorkloadPageData();
  const routes = [...await loadDatasetResults(), ...workloads];
  const latest = latestRoutes(workloads, (route) => `${route.version}/${route.name}`);
  return latest.map((route) => ({
    params: { version: route.version, name: route.name },
    props: { route, routes, description: descriptions.get(route.name)! },
  }));
}

const { route, routes, description } = Astro.props;
---

<WorkloadResultPage route={route} routes={routes} description={description} />
