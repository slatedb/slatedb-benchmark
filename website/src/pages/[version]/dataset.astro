---
import DatasetResultPage from '../../components/DatasetResultPage.astro';
import {
  latestRoutes,
  loadDatasetResults,
  loadWorkloadResults,
} from '../../lib/results';

export async function getStaticPaths() {
  const datasets = await loadDatasetResults();
  const routes = [...datasets, ...await loadWorkloadResults()];
  const latest = latestRoutes(datasets, (route) => route.version);
  return latest.map((route) => ({
    params: { version: route.version },
    props: { route, routes },
  }));
}

const { route, routes } = Astro.props;
---

<DatasetResultPage route={route} routes={routes} />
