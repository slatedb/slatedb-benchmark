---
import Base from '../layouts/Base.astro';
import ResultContext from './ResultContext.astro';
import SiteHeader from './SiteHeader.astro';
import { formatIecBytes } from '../lib/format';
import type { GoldenManifest, ResultRoute } from '../lib/results';

interface Props {
  route: ResultRoute<GoldenManifest>;
  routes: ResultRoute<unknown>[];
}

const { route, routes } = Astro.props;
const result = route.result;
---

<Base title={`${result.golden_id} · SlateDB ${route.version}`}>
  <SiteHeader />
  <main class="result-shell">
    <ResultContext
      version={route.version}
      kind="dataset"
      name="dataset"
      goldenId={result.golden_id}
      source={result.source}
      environment={result.environment}
      run={route.run}
      rawResult={`/raw/${route.rawBase}/golden.json`}
      routes={routes}
    />
    <article class="result-content">
      <header class="page-heading">
        <p class="eyebrow">Golden dataset</p>
        <h1>{result.golden_id}</h1>
      </header>

      <section class="metric-section">
        <div class="section-heading"><h2>Dataset</h2></div>
        <div class="table-scroll">
          <table>
            <tbody>
              <tr><th scope="row">Records</th><td>{result.dataset.record_count.toLocaleString('en-US')}</td></tr>
              <tr><th scope="row">Key bytes</th><td>{result.dataset.key_bytes.toLocaleString('en-US')}</td></tr>
              <tr><th scope="row">Value bytes</th><td>{result.dataset.value_bytes.toLocaleString('en-US')}</td></tr>
              <tr><th scope="row">Logical data</th><td>{formatIecBytes(result.dataset.logical_bytes)}</td></tr>
              <tr><th scope="row">Live SST data</th><td>{formatIecBytes(result.dataset.live_sst_bytes)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </article>
  </main>
</Base>
