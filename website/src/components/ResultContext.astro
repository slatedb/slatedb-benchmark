---
import {
  compareVersions,
  datasetHref,
  routeHref,
  transferCapacityHref,
  versionLabel,
  type BenchmarkRun,
  type Environment,
  type ResultRoute,
  type SourceIdentity,
} from '../lib/results';

interface Props {
  version: string;
  kind: 'dataset' | 'workload';
  name: string;
  goldenId: string;
  source: SourceIdentity;
  environment: Environment;
  run: BenchmarkRun;
  rawResult: string;
  rawSeries?: string;
  actionsLogUrl?: string;
  routes: ResultRoute<unknown>[];
}

const {
  version,
  kind,
  name,
  goldenId,
  source,
  environment,
  run,
  rawResult,
  rawSeries,
  actionsLogUrl,
  routes,
} = Astro.props;
const versions = [...new Set(
  routes.map((route) => route.version),
)]
  .sort((left, right) => compareVersions(right, left));
const versionRoutes = routes.filter((route) => route.version === version);
const currentRunRoutes = versionRoutes.filter((route) => route.run.id === run.id);
const workloads = currentRunRoutes
  .filter((route) => route.kind === 'workload')
  .sort((left, right) => left.name.localeCompare(right.name));
const versionOptions = versions.map((candidate) => {
  const candidateRoutes = routes.filter((route) => route.version === candidate);
  const target = kind === 'dataset'
    ? candidateRoutes.find(
      (route) => route.kind === 'golden',
    )
    : candidateRoutes.find(
      (route) => route.kind === 'workload' && route.name === name,
    ) ?? candidateRoutes.find((route) => route.kind === 'workload');
  return {
    version: candidate,
    label: versionLabel(candidate),
    href: target ? routeHref(target) : datasetHref(candidate),
  };
});
const recordedRoutes = versionRoutes.filter((route) =>
  kind === 'dataset'
    ? route.kind === 'golden'
    : route.kind === 'workload' && route.name === name
);
const recordedOptions = [...new Map(
  recordedRoutes.map((route) => [route.run.id, route]),
).values()].sort((left, right) =>
  Date.parse(right.run.startedAt) - Date.parse(left.run.startedAt)
);
const hasDataset = currentRunRoutes.some(
  (route) => route.kind === 'golden',
);
const patchHref = (patch: string) =>
  `https://github.com/slatedb/slatedb-benchmark/blob/${run.runnerCommit}/patches/slatedb/${encodeURIComponent(patch)}`;
const objectStore = environment.object_store === 's3'
  ? 'S3'
  : environment.object_store === 'tigris'
    ? 'Tigris'
    : environment.object_store;
const transferCapacityProviders = new Set(['s3', 'tigris']);
const warpBuildDocs = (() => {
  const runner = environment.runner_type.toLowerCase();
  if (!runner.startsWith('warp-')) return undefined;
  if (runner.includes('ubuntu') && runner.includes('arm64')) return 'linux-arm64';
  if (runner.includes('ubuntu') && runner.includes('x64')) return 'linux-x86-64';
  if (runner.includes('macos')) return 'macos-m4-pro-on-arm64';
  if (runner.includes('windows')) return 'windows-x86-64';
  return undefined;
})();
const machineHref = warpBuildDocs
  ? `https://www.warpbuild.com/docs/ci/cloud-runners#${warpBuildDocs}`
  : undefined;
---

<aside class="result-context" aria-label="Benchmark context">
  <div class="context-block">
    <label class="context-label" for="result-version">Version</label>
    <select class="route-select" id="result-version" data-route-select>
      {versionOptions.map((option) => (
        <option value={option.href} selected={option.version === version}>{option.label}</option>
      ))}
    </select>
  </div>

  <div class="context-block">
    <label class="context-label" for="result-recorded">Recorded</label>
    <select class="route-select" id="result-recorded" data-route-select>
      {recordedOptions.map((route) => (
        <option
          value={routeHref(route)}
          selected={route.run.id === run.id}
          data-local-timestamp={route.run.startedAt}
        >
          {new Date(route.run.startedAt).toLocaleString('en-US', {
            timeZone: 'UTC',
            timeZoneName: 'short',
          })}
        </option>
      ))}
    </select>
  </div>

  <div class="context-block">
    <label class="context-label" for="result-workload">Workloads</label>
    <select class="route-select workload-select" id="result-workload" data-route-select>
      {kind === 'dataset' && <option value="" selected>Choose workload</option>}
      {workloads.map((route) => (
        <option value={routeHref(route)} selected={kind === 'workload' && route.name === name}>
          {route.name}
        </option>
      ))}
    </select>
    <nav class="link-list" aria-label="Workload results">
      {workloads.map((route) => (
        <a class:list={{ current: kind === 'workload' && route.name === name }} href={routeHref(route)}>
          {route.name}
        </a>
      ))}
    </nav>
  </div>

  <dl class="metadata-list">
    <div>
      <dt>Golden data</dt>
      <dd>{hasDataset ? <a href={datasetHref(version, run.id)}>{goldenId}</a> : goldenId}</dd>
    </div>
    <div>
      <dt>Object store</dt>
      <dd>
        {transferCapacityProviders.has(environment.object_store)
          ? <a href={transferCapacityHref(environment.object_store)}>{objectStore}</a>
          : objectStore}
        {environment.region && <span> · {environment.region}</span>}
      </dd>
    </div>
    <div>
      <dt>Machine</dt>
      <dd>
        {machineHref
          ? <a href={machineHref} target="_blank" rel="noreferrer">{environment.runner_type}<span aria-hidden="true">&nbsp;↗</span></a>
          : environment.runner_type}
        {environment.runner_region && <span> · {environment.runner_region}</span>}
      </dd>
    </div>
    <div>
      <dt>Patches</dt>
      <dd>
        {run.patches.length > 0 ? (
          <ul class="patch-list">
            {run.patches.map((patch) => (
              <li>
                <a href={patchHref(patch.name)} title={`SHA-256: ${patch.sha256}`}>
                  {patch.name}
                </a>
              </li>
            ))}
          </ul>
        ) : 'None'}
      </dd>
    </div>
  </dl>

  <div class="context-links">
    <a href={rawResult}>Raw result</a>
    {rawSeries && <a href={rawSeries}>Raw time series</a>}
    {actionsLogUrl && <a href={actionsLogUrl} target="_blank" rel="noreferrer">Actions log ↗</a>}
    <a
      href={`https://github.com/slatedb/slatedb/tree/${source.slate_commit}`}
      target="_blank"
      rel="noreferrer"
    >
      SlateDB source ↗
    </a>
    <a
      href={`https://github.com/slatedb/slatedb-benchmark/tree/${source.runner_commit}`}
      target="_blank"
      rel="noreferrer"
    >
      Benchmark source ↗
    </a>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLOptionElement>('[data-local-timestamp]').forEach((option) => {
    const date = new Date(option.dataset.localTimestamp ?? '');
    if (!Number.isNaN(date.getTime())) {
      option.textContent = date.toLocaleString('en-US', { timeZoneName: 'short' });
    }
  });

  document.querySelectorAll<HTMLSelectElement>('[data-route-select]').forEach((select) => {
    select.addEventListener('change', () => {
      if (select.value) window.location.assign(select.value);
    });
  });
</script>
