---
interface Row {
  label: string;
  values: string[];
  help?: string;
  chart?: {
    kind: 'time' | 'latency';
    source: string;
    key?: string;
    unit: string;
    divisor?: number;
    average?: number;
  };
}

interface Props {
  title: string;
  firstColumn: string;
  columns: string[];
  rows: Row[];
  codeLabels?: boolean;
  idPrefix?: string;
}

const {
  title,
  firstColumn,
  columns,
  rows,
  codeLabels = true,
  idPrefix = 'metric',
} = Astro.props;
---

<section class="metric-section">
  <div class="section-heading">
    <h2>{title}</h2>
  </div>
  {rows.length > 0 ? (
    <div class="table-scroll">
      <table class="metric-table" data-chart-table>
        <thead>
          <tr>
            <th scope="col">{firstColumn}</th>
            {columns.map((column) => <th scope="col">{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, index) => {
            const panelId = `${idPrefix}-${index}-chart`;
            const helpId = `${idPrefix}-${index}-help`;
            const label = codeLabels ? <code>{row.label}</code> : row.label;
            return (
              <Fragment>
                <tr class:list={{ 'chart-trigger-row': row.chart }} data-chart-row={row.chart ? '' : undefined}>
                  <th scope="row">
                    {row.chart || row.help ? (
                      <div class:list={{ 'metric-row-controls': true, 'chart-row-controls': row.chart }}>
                        {row.chart ? (
                          <button
                            type="button"
                            class="chart-row-button"
                            aria-expanded="false"
                            aria-controls={panelId}
                            data-chart={JSON.stringify({ ...row.chart, label: row.label })}
                          >
                            {label}
                          </button>
                        ) : label}
                        {row.help && (
                          <span class="metric-help">
                            <button
                              type="button"
                              class="metric-help-trigger"
                              aria-label={`About ${row.label} latency`}
                              aria-describedby={helpId}
                              data-metric-help
                            >
                              i
                            </button>
                            <span class="metric-help-tooltip" id={helpId} role="tooltip">
                              {row.help}
                            </span>
                          </span>
                        )}
                        {row.chart && (
                        <span class="chart-row-icon" aria-hidden="true">›</span>
                        )}
                      </div>
                    ) : label}
                  </th>
                  {row.values.map((value) => <td>{value}</td>)}
                </tr>
                {row.chart && (
                  <tr class="chart-detail-row" hidden data-chart-detail>
                    <td colspan={columns.length + 1}>
                      <div class="chart-detail" id={panelId} data-chart-panel data-open="false">
                        <p class="chart-status" role="status">Loading chart…</p>
                      </div>
                    </td>
                  </tr>
                )}
              </Fragment>
            );
          })}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="empty-table">No calls were recorded.</p>
  )}
</section>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const active = document.activeElement;
    if (active instanceof HTMLElement && active.matches('[data-metric-help]')) {
      active.blur();
    }
  });
</script>
